#include <stdio.h>
#include <string.h>

struct Patient {
    char name[50], blood[5], note[100];
    int age, id;
};

void printPatients(struct Patient x[], int size) {
    for (int i = 0; i < size; i++) {
        printf("\n[%d] %s | %d yrs | %s | ID:%d\n",
               i + 1, x[i].name, x[i].age, x[i].blood, x[i].id);
        printf("Diagnosis: %s\n", x[i].note);
    }
}

void findPatient(struct Patient x[], int size, int key) {
    int found = 0;
    for (int i = 0; i < size; i++) {
        if (x[i].id == key) {
            printf("\nRecord Found:\n%s (%d)\n%s\n",
                   x[i].name, x[i].age, x[i].note);
            found = 1;
        }
    }
    if (!found)
        printf("No record exists.\n");
}

int main() {
    struct Patient p[5];

    for (int i = 0; i < 5; i++) {
        printf("\nPatient %d\n", i + 1);

        scanf(" %[^\n]", p[i].name);
        scanf("%d", &p[i].age);
        scanf("%s", p[i].blood);
        scanf("%d", &p[i].id);
        scanf(" %[^\n]", p[i].note);
    }

    printPatients(p, 5);

    int id;
    printf("\nSearch ID: ");
    scanf("%d", &id);

    findPatient(p, 5, id);
    return 0;
}




