#include <stdio.h>

int totalPower(int n) {
    if (n == 1)
        return 100;

    return (2 * totalPower(n - 1)) + 100;
}

int main() {
    int f;
    printf("Floors: ");
    scanf("%d", &f);

    printf("Total: %d kWh\n", totalPower(f));
    return 0;
}




