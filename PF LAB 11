#include <stdio.h>
#include <string.h>

struct Order {
    int id, qty;
    char cust[50], item[50], status[20];
    float price;
};

float total(struct Order o) {
    return o.qty * o.price;
}

void showStatus(struct Order o[], int n, char *s) {
    for (int i = 0; i < n; i++) {
        if (strcmp(o[i].status, s) == 0) {
            printf("\nID:%d | %s | %s\n",
                   o[i].id, o[i].cust, o[i].item);
        }
    }
}

int main() {
    struct Order o[4];

    for (int i = 0; i < 4; i++) {
        scanf("%d", &o[i].id);
        scanf(" %[^\n]", o[i].cust);
        scanf(" %[^\n]", o[i].item);
        scanf("%d", &o[i].qty);
        scanf("%f", &o[i].price);
        scanf("%s", o[i].status);
    }

    for (int i = 0; i < 4; i++)
        printf("Order %d Total: %.2f\n", i + 1, total(o[i]));

    char s[20];
    printf("Filter status: ");
    scanf("%s", s);

    showStatus(o, 4, s);
    return 0;
}


