#include <stdio.h>

int ways(int n) {
    if (n <= 1)
        return 1;
    return ways(n - 1) + ways(n - 2);
}

void showPaths(int n, int arr[], int idx) {
    if (n == 0) {
        for (int i = 0; i < idx; i++) {
            printf("%d", arr[i]);
            if (i < idx - 1) printf("+");
        }
        printf("\n");
        return;
    }

    if (n >= 1) {
        arr[idx] = 1;
        showPaths(n - 1, arr, idx + 1);
    }

    if (n >= 2) {
        arr[idx] = 2;
        showPaths(n - 2, arr, idx + 1);
    }
}

int main() {
    int n, path[20];

    printf("Enter N: ");
    scanf("%d", &n);

    printf("Ways: %d\n", ways(n));
    showPaths(n, path, 0);

    return 0;
}





