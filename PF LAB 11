#include <stdio.h>
#include <ctype.h>

void countAll(char *s, int *upper, int *digits) {
    if (*s == '\0')
        return;

    if (*s >= 'A' && *s <= 'Z')
        (*upper)++;

    if (*s >= '0' && *s <= '9')
        (*digits)++;

    countAll(s + 1, upper, digits);
}

int main() {
    char str[100];
    int u = 0, d = 0;

    printf("Enter password: ");
    scanf("%s", str);

    countAll(str, &u, &d);

    printf("Uppercase: %d\nDigits: %d\n", u, d);
    return 0;
}



