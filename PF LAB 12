#include <stdio.h>
#include <stdlib.h>

int main() {
    int n;
    float *grades;

    printf("Enter number of students: ");
    scanf("%d", &n);

    grades = (float*) malloc(n * sizeof(float));

    for(int i = 0; i < n; i++) {
        printf("Enter grade: ");
        scanf("%f", &grades[i]);
    }

    printf("Grades:\n");
    for(int i = 0; i < n; i++) {
        printf("%.2f\n", grades[i]);
    }

    free(grades);
    return 0;
}


