#include <stdio.h>
#include <stdlib.h>

int main() {
    int *contacts;

    contacts = (int*) malloc(3 * sizeof(int));

    for(int i = 0; i < 3; i++) {
        printf("Enter contact: ");
        scanf("%d", &contacts[i]);
    }

    contacts = (int*) realloc(contacts, 5 * sizeof(int));

    for(int i = 3; i < 5; i++) {
        printf("Enter contact: ");
        scanf("%d", &contacts[i]);
    }

    printf("Contacts:\n");
    for(int i = 0; i < 5; i++) {
        printf("%d ", contacts[i]);
    }

    free(contacts);
    return 0;
}


