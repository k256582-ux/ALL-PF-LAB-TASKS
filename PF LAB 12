#include <stdio.h>
#include <stdlib.h>

int main() {
    int n;
    float *buffer;

    printf("Enter number of sensors: ");
    scanf("%d", &n);

    buffer = (float*) calloc(n, sizeof(float));

    printf("Initial values:\n");
    for(int i = 0; i < n; i++) {
        printf("%.2f ", buffer[i]);
    }

    printf("\nEnter values:\n");
    for(int i = 0; i < n; i++) {
        scanf("%f", &buffer[i]);
    }

    printf("Data:\n");
    for(int i = 0; i < n; i++) {
        printf("%.2f ", buffer[i]);
    }

    free(buffer);
    return 0;
}
